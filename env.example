# ShopAIKey - never expose this as NEXT_PUBLIC_*
SHOPAIKEY_API_KEY=sk-your-shopaikey-key
SHOPAIKEY_BASE_URL=https://api.shopaikey.com

# Model used server-side to semantically compile long video prompts before Grok Video 3.
PROMPT_OPTIMIZER_MODEL=gpt-5.4

# Neon Postgres (Vercel Marketplace / Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Vercel Blob (attach a Blob store to the project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional but strongly recommended on any public Vercel URL.
# Browser will show a standard Basic Auth login dialog.
APP_USER=admin
APP_PASSWORD=replace-with-a-long-password
